    $(function () {
        $("#estadoFilter").dxSelectBox({
            dataSource: [
                { value: "ALL", text: "Todos" },
                { value: "A", text: "Activos" },
                { value: "I", text: "Inactivos" }
            ],
            valueExpr: "value",
            displayExpr: "text",
            value: "ALL", // valor por defecto
            onValueChanged: function (e) {
                let grid = $("#gridContainerFile").dxDataGrid("instance");

                if (e.value === "ALL") {
                    grid.clearFilter(); // sin filtro
                } else {
                    grid.filter(["ESTADO", "=", e.value]);
                }
            },
            width: 150,
            placeholder: "Filtrar Estado"
        });
    });
   


    function loadGridFile() {

        $(() => {
            const DxSource = new DevExpress.data.CustomStore({
                key: 'NroOp',
                load() {
                    return sendRequest(`/Operaciones/ListarFilesI?anio=` + $("#txtanio").val()).then(data => {
                        // Agrupar por FileId
                        const grouped = data.reduce((acc, item) => {
                            let existing = acc.find(x => x.FileId === item.FileId);
                            if (existing) {
                                // Concatenar Orden de Compra
                                if (!existing.OrdC.includes(item.OrdC)) {
                                    existing.OrdC += " / " + item.OrdC;
                                }
                            } else {
                                // Clonar objeto para no mutar el original
                                acc.push({ ...item });
                            }
                            return acc;
                        }, []);

                        return grouped;
                    });
                },

            });




            const dataGrid = $('#gridContainerFile').dxDataGrid({
                allowExpandAll: true,
                expandAll: true,
                keyExpr: 'FileId', // asegúrate de que coincida con tu clave
                noDataText: "No hay información para mostrar",

                grouping: { autoExpandAll: true },

                allowSorting: false,
                allowFiltering: true,
                allowColumnResizing: true,

                showRowTotals: true,
                showColumnTotals: true,
                showRowGrandTotals: true,
                showTotals: true,
                editing: {
                    mode: "cell",
                    useIcons: true,
                    allowUpdating: true,
                },

                showGrandTotals: false,
                showColumnGrandTotals: false,
                height: 700,
                fieldChooser: { enabled: false },

                dataSource: { store: DxSource, pageSize: 20, pageIndex: 0 },

                columns: columnsConfig,

                hoverStateEnabled: false,
                filterRow: { visible: true },
                showColumnLines: true,
                showRowLines: true,
                rowAlternationEnabled: true,
                showBorders: true,

                selection: { mode: 'single' },
                paging: { pageSize: 15 },

                onCellValueChanged: function (e) {
                    if (e.column.dataField === "ESTADO") {
                        let nuevoEstado = e.value;
                        let fileId = e.data.FileID;

                        $.ajax({
                            url: '/Operaciones/CambioEstado',
                            type: 'POST',
                            data: { id: fileId, estado: nuevoEstado },
                            success: function () {
                                DevExpress.ui.dialog.alert("Estado actualizado correctamente.", "Éxito");
                                $("#gridContainerFile").dxDataGrid("instance").refresh();
                            },
                            error: function () {
                                DevExpress.ui.dialog.alert("Error al actualizar el estado.", "Error");
                                $("#gridContainerFile").dxDataGrid("instance").refresh();
                            }
                        });
                    }
                },



            }).dxDataGrid('instance');


        })

    }






    function RegistrarFile(){
        var grid = $('#gridContainerFile').dxDataGrid('instance');

        var selectedData = grid.getSelectedRowsData();
        /*SECCION EDITAR*/
        //if (selectedData.length > 0) {

