                customClass: {
                    container: 'my-swal-container', // Clase personalizada para ajustar z-index
                },
            });
        }*/

        /*POPUP DE LA VISTA REGISTRAR*/


        $("#popupContainerEP").dxPopup({
                width: 1300,
                height: 900,
                showTitle: true,
                title: "Registrar File (Importación)",
                visible: false, // Mantén el popup oculto hasta que sea necesario
                dragEnabled: true,
                hideOnOutsideClick: true,
                contentTemplate: function (contentElement) {
                    // Cargar el contenido mediante AJAX
                    $.ajax({

                        url: '@Url.Content("~/Operaciones/Registrar")',
                        type: "GET",
                        success: function (data) {
                            contentElement.html(data);
                        },
                        error: function () {
                            contentElement.html("<p>Error al cargar el contenido.</p>");
                        }
                    });
                },
                onHidden: function () { // Agregar este evento
                    var gridPrincipal = $("#gridContainerFile").dxDataGrid("instance");
                    if (gridPrincipal) {
                        gridPrincipal.refresh(); // O gridPrincipal.reload()
                    }
                }
            }).dxPopup("show");



    }

    function EditarFile() {

        var grid = $('#gridContainerFile').dxDataGrid('instance');

        var selectedData = grid.getSelectedRowsData();

        if (selectedData.length > 0) {

            var file = selectedData[0]; // fila seleccionada completa
            var estado = file.ESTADO;

            var fileId = file.FileId; // ahora sí usas el id real


            $("#popupContainerEF").dxPopup({
                    width: 1300,
                    height: 900,
                    showTitle: true,
                    title: "Editar File (Importación)",
                    visible: false, // Mantén el popup oculto hasta que sea necesario
                    dragEnabled: true,
                    hideOnOutsideClick: true,
                    contentTemplate: function (contentElement) {
                        // Cargar el contenido mediante AJAX
                        $.ajax({

                            url: '@Url.Content("~/Operaciones/Editar")' + '?estado=' + estado,
                            type: "GET",
                            success: function (data) {
                                contentElement.html(data);
                            },
                            error: function () {
                                contentElement.html("<p>Error al cargar el contenido.</p>");
                            }
                        });
                    },
                    onHidden: function () { // Agregar este evento
                        var gridPrincipal = $("#gridContainerFile").dxDataGrid("instance");
                        if (gridPrincipal) {
                            gridPrincipal.refresh(); // O gridPrincipal.reload()
                        }
                    }
            }).dxPopup("show");

        } else {
            // Si no hay una fila seleccionada, muestra un mensaje o realiza otra acción
            Swal.fire({
                icon: 'error',
                title: 'Oops...',
                text: 'Selecciona una fila antes de registrar.',
                customClass: {
                    container: 'my-swal-container', // Clase personalizada para ajustar z-index
                },
            });
        }

        /*POPUP DE LA VISTA REGISTRAR*/





    }

    function MigrarFile() {
        var grid = $('#gridContainerFile').dxDataGrid('instance');
        var selectedData = grid.getSelectedRowsData();
        if (selectedData.length > 0) {
            Swal.fire({
                title: "Seguro que desea migrar?",
                showCancelButton: true,
                confirmButtonText: "Migrar"
            }).then((result) => {
                /* Read more about isConfirmed, isDenied below */
                if (result.isConfirmed) {
                    Swal.fire("Saved!", "", "success");
                }
            });
        } else {
            // Si no hay una fila seleccionada, muestra un mensaje o realiza otra acción
            Swal.fire({
                icon: 'error',
                title: 'Oops...',
                text: 'Selecciona una fila para migrar.',
                customClass: {
                    container: 'my-swal-container', // Clase personalizada para ajustar z-index
                },
            });
        }
    }

    function Actualizar() {
        var dataGrid = $('#gridContainerFile').dxDataGrid('instance');
        dataGrid.refresh();
    }
</script>





