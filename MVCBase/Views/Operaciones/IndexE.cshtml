
@{
    ViewBag.Title = "IndexE";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div id="frmFibra">
    <div class="form-horizontal">
        <div class="panel panel-default">
            <div class="panel-body">
                <div style="background: #002762;">
                    <div class="form-horizontal">
                        <div class="form-group" style="margin-bottom: 0px !important;padding-bottom:5px">
                            <div class="col-md-6" style="padding-top: 5px;">
                                <div class="toolbar-item">
                                @*<img src="/img/logo.png" class="toolbar-icon">*@
                                    <span class="toolbar-title">Files (Exportaciones)</span>
                                    <input id="txtanio" class="form-control txtano">
                                </div>
                            </div>
                            <div class="col-md-6 " style="padding-top: 20px;">
                                <button type="button"
                                        class="btn btn-primary ClsRefresh  pull-right"
                                        style="margin-right: 15px;"
                                        name="btnActualizar" id="btnActualizar" onclick="Actualizar()">
                                    <span class="glyphicon glyphicon-refresh"></span>&nbsp;Actualizar
                                </button>
                                <button type="button"
                                        class="btn btn-warning ClsEditar  pull-right"
                                        style="margin-right: 15px;"
                                        name="btnEditar" id="btnEditar" onclick="EditarFile()">
                                    <span class="glyphicon glyphicon-pencil"></span>&nbsp;Editar
                                </button>
                                <button type="button"
                                        class="btn btn-success ClsAgregar pull-right"
                                        style="margin-right: 15px;"
                                        name="btnRegistrar" id="btnRegistrar" onclick="RegistrarFile()">
                                    <span class="glyphicon glyphicon-plus"></span>&nbsp;Registrar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="gridContainer">

                </div>
            </div>
        </div>



        <!-- Contenedor para el dxPopup Registrar. -->
        <div id="popupContainerEP"></div>
    </div>
</div>

<script>

    var today = new Date();
    var year = today.getFullYear();
    $(document).ready(function () {
        $("#txtanio").val(year);
        loadGridFile();

        $('#txtanio').on('keypress', function (e) {
            if (e.which === 13) {
                Actualizar();
            }
        });

    })




    var columnsConfig = [
        {
            dataField: 'FileId', caption: 'Id File', alignment: 'left', visible: false, 
        },
        {
            dataField: 'CodFile', caption: 'Cod File', alignment: 'left',
        },
        {
            dataField: 'NombreF', caption: 'Nombre File', alignment: 'left',
        },
        {
            dataField: 'FechaOp', caption: 'FechaOp', alignment: 'left', dataType: "date", format: "dd/MM/yyyy"

        },
        {
            dataField: 'NroOp', caption: 'NroOp', alignment: 'left',  visible: false
        },
        {
            dataField: 'NumeroOperacion', caption: 'Nro Operación', alignment: 'left',
        },
        {
            dataField: 'Control_Comex', caption: 'Control Comex', alignment: 'left',
        },
        {
            dataField: 'IE_Anio', caption: 'Instrucción Embarque Año', alignment: 'left',
        },
        {
            dataField: 'IE_Nro', caption: 'Instrucción Embarque Nro', alignment: 'left',
        },
        {
            dataField: 'Proveedor', caption: 'Cliente', alignment: 'left',
        },
        {
            dataField: 'CantPrendas', caption: 'Cant Prendas', alignment: 'right',  format: ",##0.###"
        },
         {
            dataField: 'Detalle', alignment: 'left', visible: false
        }


    ];







    function loadGridFile() {

        $(() => {
            const DxSource = new DevExpress.data.CustomStore({
                key: 'FileId',

                load() {
                    return sendRequest(`/Operaciones/ListarFilesE?anio=` + $("#txtanio").val()).then(data => {
                        return data;
                    });
                },
            });




            const dataGrid =
                $('#gridContainer').dxDataGrid({
                    allowExpandAll: true,
                    expandAll: true,
                    keyExpr: 'FileId',

                    noDataText: "No hay información para mostrar",


                    allowSorting: false,
                    allowFiltering: true,
                    allowColumnResizing: true,
                    showRowTotals: true,
                    showColumnTotals: true,
                    showRowGrandTotals: true,
                    showTotals: true,
                    editing: {
                        mode: 'popup',
                        //allowUpdating: true,
                        useIcons: true,
                        //allowDeleting: true,//sirve para confirmar tu eliminacion


                        form: {

                        }
                    },


                    showGrandTotals: false,
                    showColumnGrandTotals: false,
                    height: 700,
                    fieldChooser: {
                        enabled: false,
                    },

                    dataSource: {

                        store: DxSource,
                        pageSize: 20, // Set the desired page size
                        pageIndex: 0 // Set the initial page index
                    },


                    onEditorPreparing: {},
                    onrRowInserted(e) {
                        e.component.navigateToRow(e.key);
                    },
                    columns: columnsConfig,

                    hoverStateEnabled: false,
                    filterRow: { visible: true },
                    showColumnLines: true,
                    showRowLines: true,
                    rowAlternationEnabled: true,
                    showBorders: true,
                    selection: {
                        mode: 'single',
                    },
                    paging: {
                        pageSize: 15,  // Set the number of rows per page as per your requirement
                    },



                }).dxDataGrid('instance');


        })

    }






    function RegistrarFile(){
        var grid = $('#gridContainer').dxDataGrid('instance');

        var selectedData = grid.getSelectedRowsData();
        /*SECCION EDITAR*/
        //if (selectedData.length > 0) {

            //console.log("selectedRowData para editar: ", selectedData[0].IdPeriodoInventario);
            //console.log("selectedRowData para editar: ", selectedData[0]);

        /*} else {
            // Si no hay una fila seleccionada, muestra un mensaje o realiza otra acción
            Swal.fire({
                icon: 'error',
                title: 'Oops...',
                text: 'Selecciona una fila antes de registrar.',
                customClass: {
                    container: 'my-swal-container', // Clase personalizada para ajustar z-index
                },
            });
        }*/

        /*POPUP DE LA VISTA REGISTRAR*/


        $("#popupContainerEP").dxPopup({
                width: 1200,
                height: 900,
                showTitle: true,
                title: "Registrar File (Exportación)",
                visible: false, // Mantén el popup oculto hasta que sea necesario
                dragEnabled: true,
                hideOnOutsideClick: true,
                contentTemplate: function (contentElement) {
                    // Cargar el contenido mediante AJAX
                    $.ajax({

                        url: '@Url.Content("~/Operaciones/RegistrarE")',
                        type: "GET",
                        success: function (data) {
                            contentElement.html(data);
                        },
                        error: function () {
                            contentElement.html("<p>Error al cargar el contenido.</p>");
                        }
                    });
                },
                onHidden: function () { // Agregar este evento
                    var gridPrincipal = $("#gridContainer").dxDataGrid("instance");
                    if (gridPrincipal) {
                        gridPrincipal.refresh(); // O gridPrincipal.reload()
                    }
                }

            }).dxPopup("show");



    }
    function EditarFile() {

        var grid = $('#gridContainer').dxDataGrid('instance');

        var selectedData = grid.getSelectedRowsData();

        if (selectedData.length > 0) {

            console.log("selectedRowData para editar : ", selectedData);

            $("#popupContainerEP").dxPopup({
                    width: 1300,
                    height: 900,
                    showTitle: true,
                    title: "Editar File (Exportación)",
                    visible: false, // Mantén el popup oculto hasta que sea necesario
                    dragEnabled: true,
                    hideOnOutsideClick: true,
                    contentTemplate: function (contentElement) {
                        // Cargar el contenido mediante AJAX
                        $.ajax({

                            url: '@Url.Content("~/Operaciones/EditarExp?FileId=")' + selectedData[0].FileId,
                            type: "GET",
                            success: function (data) {
                                contentElement.html(data);
                            },
                            error: function () {
                                contentElement.html("<p>Error al cargar el contenido.</p>");
                            }
                        });
                    },
                    onHidden: function () { // Agregar este evento
                        var gridPrincipal = $("#gridContainer").dxDataGrid("instance");
                        if (gridPrincipal) {
                            gridPrincipal.refresh(); // O gridPrincipal.reload()
                        }
                    }
            }).dxPopup("show");

        } else {
            // Si no hay una fila seleccionada, muestra un mensaje o realiza otra acción
            Swal.fire({
                icon: 'error',
                title: 'Oops...',
                text: 'Selecciona una fila antes de registrar.',
                customClass: {
                    container: 'my-swal-container', // Clase personalizada para ajustar z-index
                },
            });
        }

        /*POPUP DE LA VISTA REGISTRAR*/





    }
    function Actualizar() {
        var dataGrid = $('#gridContainer').dxDataGrid('instance');
        dataGrid.refresh();
    }


</script>



