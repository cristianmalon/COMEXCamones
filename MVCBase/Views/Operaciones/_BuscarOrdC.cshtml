    function fecha(dato) {
        if (!dato) {
            return ""; // Permitir vacío sin error
        }

        let timestamp = dato.match(/\d+/); // Extraer solo los números del formato /Date(1693459200000-0500)/

        if (!timestamp) {
            console.error("Error: Formato de fecha incorrecto", dato);
            return "";
        }

        let date = new Date(parseInt(timestamp[0]));

        let day = date.getDate().toString().padStart(2, '0');
        let month = (date.getMonth() + 1).toString().padStart(2, '0');
        let year = date.getFullYear();

        return `${year}-${month}-${day}`;
    }


