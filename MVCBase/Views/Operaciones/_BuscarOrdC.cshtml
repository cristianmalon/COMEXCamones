                dataField: 'Qty',
                caption: 'Qty.',
                alignment: 'right',
                allowEditing: false,
                customizeText: function (e) {
                    if (e.value === null || e.value === undefined) return "";
                    return new Intl.NumberFormat("en-US").format(e.value); // 👉 siempre coma como separador
                },
                setCellValue(newData, value) {
                    newData.Qty = Math.round(value);
                }
            },
            {
                dataField: 'Valor',
                caption: 'Valor',
                alignment: 'right',
