                    <input type="date" id="txtEtaCallao_@ViewBag.Id" class="form-control">
                </div>
                <div class="col-md-3">
                    <label>Vcto Sobrestadia</label>
                    <input type="date" id="txtSobrestadia_@ViewBag.Id" class="form-control">
