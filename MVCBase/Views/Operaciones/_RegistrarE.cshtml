@model  CAMTEX.Entidades.Files
<div id="frmRegistrar">
    <div class="form-horizontal">
        <div class="row">
            <div class="col-md-12">
                <div class="form-horizontal">

                    <!--SECCION FILE-->
                    <div class="form-group" style="display:none">
                        <div class="col-md-6">
                            <label>Codigo File</label>
                            <input type="text" id="txtCFile" class="form-control-border" style="background-color: #eee; border: 1px solid #ccc; " readonly />
                        </div>

                    </div>
                    <div class="form-group">
                        <div class="col-md-4">
                            <label>Nombre File</label>
                            <input type="text" id="txtFile" class="form-control" placeholder="AUTOGENERADO" readonly>
                        </div>
                        <!--
        <div class="col-md-3">
            <label>Observación</label>
            <input type="text" id="txtObservacion" class="form-control" placeholder="Ingrese la observación">

        </div>
            -->
                        <div class="col-md-2">
                            <label>fecha Registro</label>
                            <input type="text" id="txtFechaRegistro" class="form-control"
                                   value="@(Model.FechaCreacion?.ToString("dd/MM/yyyy") ?? DateTime.Now.ToString("dd/MM/yyyy"))" readonly>
                        </div>
                        <div class="col-md-2">
                            <label>Hora</label>
                            <input type="text" id="txtHora" class="form-control"
                                   value="@(Model.FechaCreacion?.ToString("HH:mm:ss") ?? DateTime.Now.ToString("HH:mm:ss"))" readonly>
                        </div>
                        <div class="col-md-2">
                            <label>Usuario</label>
                            <input type="text" id="txtUsuario" class="form-control" value="@Model.UsuarioCreacion" readonly>

                        </div>
                        <!--<div class="col-md-1">
            <label>Estación</label>
            <input type="text" id="txtEstacion" class="form-control" value="@Model.Estacion" readonly>

        </div>-->

                        <div class="col-md-2">
                            <label>Estado</label>
                            @if (string.IsNullOrEmpty(Model.ESTADO))
                            {
                                <select id="txtEstadoE" name="ESTADO" class="form-control" disabled>
                                    <option value="A" selected>ACTIVO</option>
                                </select>
                                <input type="hidden" name="ESTADO" value="A" />
                            }
                            else  // Caso: Editar (sí existe un estado en el modelo)
                            {
                                <select id="txtEstadoE" name="ESTADO" class="form-control">
                                    <option value="A" @(Model.ESTADO == "A" ? "selected" : "")>ACTIVO</option>
                                    <option value="I" @(Model.ESTADO == "I" ? "selected" : "")>INACTIVO</option>
                                </select>
                            }
                        </div>




                    </div>
                    <div class="form-group" id="divGuardarFile">
                        <div class="col-md-6">
                            <button type="button" id="btnGuardarFile" class="btn btn-primary">Guardar File</button>

                        </div>
                    </div>
                    <!--FIN SECCION FILE-->


                    <hr style="border-top: 2px solid #33333347;" />


                    <div id="container">
                        <div id="addButton"></div>
                    </div>
                   
                    <div id="tabPanel"></div>

                    <div id="popupContainer"></div>


                    <hr style="border-top: 2px solid #33333347;" />


                    @*<div class="text-right">
            <div id="btnGuardarTodasF"></div>
        </div>*@
                    <!-- Campo oculto para guardar nuevoFileID -->
                    <input type="hidden" id="FileIDv" value="" />
                    <input type="hidden" id="FileID" value="@Model.FileId" />
                </div>
            </div>
        </div>
    </div>
</div>

<script>



    $(() => {




        let gridE = $("#gridContainer").dxDataGrid("instance");
        let filaSeleccionada = gridE.getSelectedRowsData()[0]; // la fila seleccionada


         $("#txtEstadoE").off("change").on("change", function () {
            var nuevoEstado = $(this).val();

            var o = {
                FileId: filaSeleccionada.FileId,
                Estado: nuevoEstado
            };

            // Usamos DevExpress confirm
            DevExpress.ui.dialog.confirm(
                "¿Seguro que deseas cambiar el estado a " + (nuevoEstado === "A" ? "ACTIVO" : "INACTIVO") + "?",
                "Confirmación"
            ).done(function (result) {
                if (result) {
                    $.ajax({
                        url: '/Operaciones/ActualizarEstadoFile',
                        type: 'POST',
                        data: JSON.stringify(o),
                        contentType: "application/json; charset=utf-8",
                        success: function () {
                            DevExpress.ui.dialog.alert("Estado actualizado correctamente.", "Éxito");
                        },
                        error: function () {
                            DevExpress.ui.dialog.alert("Ocurrió un error al actualizar el estado.", "Error");
                        }
                    });
                } else {
                    // Cancelado → regresar al valor original
                    $("#txtEstadoE").val('@Model.ESTADO');
                }
            });
        });

        loadPanel = $('#loadingPanel').dxLoadPanel({
            shadingColor: 'rgba(0,0,0,0.4)', // Color semi-transparente del fondo
            position: { of: '#tabPanel' }, // Se posiciona sobre el dxTabPanel
            visible: false, // Inicialmente oculto
            showIndicator: true,
            showPane: true,
            message: 'Cargando contenido...', // Mensaje opcional
            shading: true, // Muestra la sombra para bloquear interacciones
            container: '#tabPanel' // Opcional, pero ayuda a asegurar la jerarquía
        }).dxLoadPanel('instance');












        let facturasAbiertas = [];

       
         
        const tabPanel = $('#tabPanel').dxTabPanel({
            dataSource: [],
            itemTitleTemplate: titleTemplate,
            itemTemplate: loadPartialView,
            height: 650,
            deferRendering: false,
            noDataText: "No hay pestañas abiertas", // Mensaje personalizado
            showNavButtons: true,
            repaintChangesOnly: true,
            onSelectionChanged: function (e) {
                console.log("Pestaña activa AA:", e.component.option("selectedIndex"));
                $(".tab-contentss").hide();
                if (e.addedItems.length > 0 && e.addedItems[0].id) {
                    $("#tab1_" + e.addedItems[0].id).show();
                } else {
                    console.log("No hay pestañas abiertas.");
                }
            }
        }).dxTabPanel('instance');

        function titleTemplate(itemData, itemIndex, itemElement) {
            itemElement.append($('<span>').text(itemData.title));
            itemElement.append(
                $('<i>')
                    .addClass('dx-icon dx-icon-close')
                    .click(() => { closeButtonHandler(itemData); })
            );
        }

        function loadPartialView(itemData, itemIndex, itemElement) {
            
            var uniqueId = itemData.id;
            var FacturaData = itemData.data;
            debugger;

            $('<div>').addClass('tab-content').attr("data-id", uniqueId).appendTo(itemElement);
            loadPanel.show();
            // Cargar la misma vista parcial en cada tab
            $.ajax({
                url: '/Operaciones/VRFactura',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    id: uniqueId,
                    FileID: $('#FileIDv').val(),
                    FacturaData: FacturaData, // Aquí envías todo el objeto
                    ViewID: 'R'
                }),
                success: function (response) {
                    itemElement.find('.tab-content').html(response);
                    loadPanel.hide(); 
                },
                error: function () {
                    itemElement.find('.tab-content').html('<p>Error al cargar la vista.</p>');
                }
            });
        }

        /*
        function inicializarTabInterno(uniqueId) {
            // Asegurar que existe el contenedor antes de inicializar el panel interno
            const tabInterno = $(`#tabpanelInterno_${uniqueId}`);
            if (tabInterno.length) {
                tabInterno.dxTabPanel({
                    items: [
                        { title: "Lotes", template: "tabLotes_" + uniqueId },
                        { title: "Contenedores", template: "tabContenedores_" + uniqueId },
                        { title: "Operaciones", template: "tabOperaciones_" + uniqueId },
                        { title: "Facturas", template: "tabFacturas_" + uniqueId }
                    ],
                    width: "100%",
                    height: 400,
                    animationEnabled: true,
                    swipeEnabled: true
                });
            }
        }*/


        var popup = $('#popupContainer').dxPopup({
            title: 'Buscar Instrucción de embarque',
            width: 1100,
            height: 700,
            contentTemplate: function (contentElement) {
                $.ajax({
                    url: '/Operaciones/VRIE',
                    method: 'GET',
                    success: function (result) {
                        contentElement.append(result);
                        contentElement.append('<div class="dx-popup-bottom-buttons">' +
                            '<div id="btnAdd"></div>' +
                            '</div>');

                        $('#btnAdd').dxButton({
                            text: 'Seleccionar',
                            onClick: function () {
                                var grid = $("#gridIE").dxDataGrid("instance");
                                var selectedRow = grid.getSelectedRowsData()[0];
                                if (!selectedRow) {
                                    alert("Por favor, selecciona una instruccion de embarque.");
                                    return;
                                }
                                debugger;
                                //var numeroOrden = selectedRow.U_DIN_NFACT;
                                var IE_Anio = selectedRow.IE_Anio;
                                var IE_Nro = selectedRow.IE_Nro;

                                var existeOrden = facturasAbiertas.some(oc => oc.IE_Anio === IE_Anio && oc.IE_Nro === IE_Nro);
                                console.log("facturasAbiertas:", facturasAbiertas);
                                //console.log("numeroOrden:", numeroOrden);
                                if (existeOrden) {
                                    DevExpress.ui.dialog.alert("Esta Instruccion de embarque ya esta seleccionada.", "Aviso");
                                    return;
                                }
                                // Guardamos la IE en la base Datos

                                var tabPanelItems = tabPanel.option('dataSource');
                                var BEOperaciones = {
                                    FileID: $('#FileIDv').val(),
                                    IE_Anio: IE_Anio,
                                    IE_Nro: IE_Nro
                                }

                                $.ajax({
                                    url: `/Operaciones/ActualizarOperacionesExpo`,
                                    type: 'POST',
                                    async: false,
                                    data: JSON.stringify({ entidad: BEOperaciones }),
                                    dataType: 'json',
                                    headers: {
                                        "Content-Type": "application/json"
                                    },
                                    success: function (res) {
                                        //debugger;
                                        if (!res.result) {
                                            DevExpress.ui.dialog.alert("Hubo un error al guardar.", "Error");

                                        } else {
                                            //var uniqueId = `tab_${Date.now()}`;
                                            //var newTab = {
                                            //    id: uniqueId,
                                            //    title: IE_Anio + '-' + IE_Nro,
                                            //    data: selectedRow // Pasamos todo el objeto seleccionado
                                            //};
                                            //tabPanelItems.push(newTab);
                                            //tabPanel.option('dataSource', tabPanelItems);
                                            //tabPanel.option('selectedIndex', tabPanelItems.length - 1);
                                            //// Agregar al array de órdenes abiertas para evitar duplicados
                                            //facturasAbiertas.push({ IE_Anio: IE_Anio, IE_Nro: IE_Nro });
                                            //popup.hide();

                                            var tabPanelItems = tabPanel.option('dataSource');

                                            var uniqueId = `tab_${Date.now()}`;
                                            var newTab = {
                                                id: uniqueId,
                                                title: IE_Anio + '-' + IE_Nro,
                                                idop: res.status,
                                                data: selectedRow // Pasamos todo el objeto seleccionado
                                            };

                                            tabPanelItems.push(newTab);
                                            tabPanel.option('dataSource', tabPanelItems);
                                            tabPanel.option('selectedIndex', tabPanelItems.length - 1);

                                            // Agregar al array de órdenes abiertas para evitar duplicados
                                            facturasAbiertas.push({ IE_Anio: IE_Anio, IE_Nro: IE_Nro });
                                            popup.hide();

                                        }
                                        console.log(res);

                                    }, complete: function (data) {
                                        //desbloqObject()
                                    }
                                });



                            }
                        });

                    },
                    error: function (error) {
                        console.error('Error al cargar la vista parcial', error);
                    }
                });
            },
            onHidden: function () {
                console.log('Ventana emergente cerrada');
            }
        }).dxPopup('instance');

        $('#addButton').dxButton({
            icon: 'add',
            text: 'Agregar Instrucción de Embarque',
            type: 'default',
            disabled: true,
            onClick: function () {
                popup.show();
            }
        });
        function closeButtonHandler(itemData) {
            DevExpress.ui.dialog.confirm("¿Estás seguro de que deseas quitar esta Factura?", "Confirmación")
                .done(function (dialogResult) {
                    if (dialogResult) { // Si el usuario confirma
                        const tabPanelItems = tabPanel.option('dataSource');
                        const index = tabPanelItems.findIndex(tab => tab.id === itemData.id);

                        if (index !== -1) {

                            //facturasAbiertas = facturasAbiertas.filter(codigo => codigo !== itemData.data.U_DIN_FCSOL);
                            facturasAbiertas = facturasAbiertas.filter(codigo =>
                                !(codigo.NumeroOrden === itemData.data.U_DIN_NFACT)
                            );

                            tabPanelItems.splice(index, 1);
                            tabPanel.option('dataSource', tabPanelItems);

                            if (index >= tabPanelItems.length && index > 0) {
                                tabPanel.option('selectedIndex', index - 1);
                            }
                        }
                    }
                });
        }

        if (($('#FileID').val() != null) && ($('#FileID').val() != 0)) {

            let gridE = $("#gridContainer").dxDataGrid("instance");

            let filaSeleccionada = gridE.getSelectedRowsData()[0]; // la fila seleccionada
            console.log("filaSeleccionada Editar: ", filaSeleccionada);

            //$("#txtCFileE").val(filaSeleccionada.FileId); // o CodFile si prefieres
            $("#txtFile").val(filaSeleccionada.CodFile);
            //$("#txtObservacion").val(filaSeleccionada.Detalle);
            //$("#txtUsuarioE").val(filaSeleccionada.UsuarioCreacion);
            $("#divGuardarFile").hide();
            // Deshabilitar el botón de "Guardar File" y campos de entrada
            $('#txtFile').prop('disabled', true);
            //$('#txtObservacion').prop('disabled', true);
            // Habilitar el botón de "Agregar O/C"
            $('#addButton').dxButton('instance').option('disabled', false);
            document.getElementById("FileIDv").value = $('#FileID').val();

            if (filaSeleccionada && filaSeleccionada.FileId) {
                let valorFileSeleccionado = filaSeleccionada.FileId;

                // Traemos todos los registros del mismo FileId para el tab panel
                sendRequest(`/Operaciones/ListarFilesE?anio=` + $("#txtanio").val()).then(datosGrid => {
                    let filasConMismoFile = datosGrid.filter(fila => fila.FileId === valorFileSeleccionado);

                    console.log("Filas con el mismo valor en FileId:", filasConMismoFile);

                    const tabPanelItems = filasConMismoFile.map(fila => ({
                        title: `${fila.IE_Anio}-${fila.IE_Nro}`,
                        id: `tab_${fila.IE_Anio}_${fila.IE_Nro}_${Date.now()}`, // UniqueId
                        idop: fila.NroOp,
                        data: {
                            "Control_Comex": fila.Control_Comex,
                            "CantPrendas": fila.CantPrendas,
                            "IE_Anio": Number(fila.IE_Anio),
                            "IE_Nro": Number(fila.IE_Nro),
                            "Cliente": fila.Proveedor
                        }
                    }));

                    tabPanel.option('dataSource', tabPanelItems);
                });

            } else {
                console.log("No se ha seleccionado una fila o la fila seleccionada no tiene la columna 'FileId'.");
            }
        }



        $('#btnGuardarFile').click(function () {
            var file = $('#txtFile').val().trim();
            //var observacion = $('#txtObservacion').val().trim();

            /*if (!file) {
                DevExpress.ui.dialog.alert("Debe ingresar un código de File antes de guardar.", "Error");
                return;
            }*/

            // Deshabilitar el botón para evitar múltiples envíos
            $('#btnGuardarFile').prop('disabled', true);
            // Llamada AJAX al controlador
            $.ajax({
                url: '/Operaciones/InsertFilesE',  // Ruta del controlador y acción
                type: 'POST',
                data: {
                    fileName: file,
                    //observacion: observacion
                },
                success: function (response) {
                    console.log("response: ", response);



                    // Aquí validamos si el SP devolvió -1
                    if (response.nuevoFileID == -1) {
                        DevExpress.ui.dialog.alert("El código de File ya existe. No se pudo registrar.", "Error");
                        $('#btnGuardarFile').prop('disabled', false); // Rehabilitar botón
                        return;
                    }

                    $("#txtFile").val(response.FileName);

                    nuevoFileID = response.nuevoFileID;
                    document.getElementById("FileIDv").value = nuevoFileID; // Asigna un nuevo ID
                    DevExpress.ui.dialog.alert("File guardado correctamente.", "Éxito").done(function () {
                        // Habilitar el botón de "Agregar O/C"
                        $('#addButton').dxButton('instance').option('disabled', false);

                        // Deshabilitar el botón de "Guardar File" y campos de entrada
                        $('#txtFile').prop('disabled', true);
                        //$('#txtObservacion').prop('disabled', true);
                        $('#btnGuardarFile').css('display', 'none');


                    });

                },
                error: function () {
                    DevExpress.ui.dialog.alert("Hubo un error al guardar el File.", "Error");
                    $('#btnGuardarFile').prop('disabled', false); // Volver a habilitar el botón en caso de error
                }
            });
        });





    });






</script>



<style>


    .dx-tabs .dx-tabs-wrapper .dx-tab {
        width: auto;
        padding-left: 20px;
    }

    .dx-sortable-dragging .dx-tab {
        box-sizing: border-box;
        text-align: center;
    }

    .employeeInfo .employeePhoto {
        height: 100px;
        float: left;
        padding: 10px 20px 10px 20px;
    }

    .caption {
        padding: 0 0 10px 30px;
        font-size: 14px;
        font-weight: bold;
    }

    .task-list {
        padding: 0 20px;
    }

        .task-list.dx-state-disabled {
            opacity: 1;
        }

            .task-list.dx-state-disabled .dx-list-item {
                opacity: 1;
            }

    .employeeInfo .employeeNotes {
        min-height: 100px;
        padding: 20px;
        text-align: justify;
        white-space: normal;
    }

    .dx-theme-generic .dx-tabs-wrapper .dx-item.dx-tab {
        max-width: fit-content;
        padding-left: 14px;
        padding-right: 9px;
        line-height: 1.618;
    }

    .dx-tabpanel .dx-tab .dx-icon.dx-icon-close {
        display: inline-block;
        margin-right: 0;
        margin-left: 7px;
        opacity: 0.6;
    }

    .dx-theme-generic .dx-tabpanel .dx-tab .dx-icon.dx-icon-close {
        font-size: 15px;
    }

    .dx-theme-material .dx-tabpanel .dx-tab .dx-icon.dx-icon-close {
        font-size: 18px;
    }

    .dx-theme-material .dx-tab-content {
        flex-direction: row;
    }

    .dx-theme-material .employeeNotes {
        margin: 0;
    }
</style>