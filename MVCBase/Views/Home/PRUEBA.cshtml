@{
    Layout = null;
    ViewBag.Title = "PRUEBA";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portada de Sistemas</title>
    <style>
        body {
            background: linear-gradient(135deg, #1e1e2f, #27293d);
            color: #fff;
            font-family: "Poppins", sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px;
            overflow: hidden;
        }

        h1 {
            text-align: center;
            margin-bottom: 25px;
        }

        /* 🔹 Contenedor del slider */
        .slider-container {
            width: 100%;
            max-width: 1200px;
            overflow: hidden;
            position: relative;
            border-radius: 20px;
        }

        .slider-track {
            display: flex;
            transition: transform 0.6s ease;
            cursor: grab;
        }

        .slide {
            min-width: 100%;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            grid-template-rows: repeat(2, 200px);
            gap: 20px;
            padding: 20px;
            box-sizing: border-box;
        }

        /* 🔹 Cards */
        .card {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            backdrop-filter: blur(12px);
            padding: 25px 20px;
            text-align: center;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

            .card:hover {
                transform: translateY(-10px) scale(1.05);
                box-shadow: 0 15px 30px rgba(0,0,0,0.5);
            }

            .card h2 {
                margin-bottom: 10px;
                font-size: 1.2rem;
            }

            .card p {
                font-size: 0.9rem;
                margin-bottom: 15px;
                color: #ddd;
            }

            .card a {
                display: inline-block;
                padding: 8px 18px;
                border-radius: 25px;
                text-decoration: none;
                background: linear-gradient(135deg, #00c6ff, #0072ff);
                color: #fff;
                font-weight: bold;
                transition: background 0.3s ease;
            }

                .card a:hover {
                    background: linear-gradient(135deg, #ff6a00, #ee0979);
                }

        /* 🔹 Controles */
        .controls {
            position: absolute;
            top: 50%;
            width: 100%;
            display: flex;
            justify-content: space-between;
            transform: translateY(-50%);
            pointer-events: none;
        }

        .btn {
            background: rgba(0,0,0,0.5);
            border: none;
            color: #fff;
            padding: 12px 16px;
            border-radius: 50%;
            cursor: pointer;
            pointer-events: all;
            margin: 0 10px;
            transition: background 0.3s ease;
        }

            .btn:hover {
                background: rgba(0,0,0,0.8);
            }
    </style>
</head>
<body>
    <div>
        <h1>🌐 Menú Principal de Sistemas</h1>
        <div class="slider-container">
            <div class="slider-track" id="slider">
                <!-- 🔹 Primer grupo de 8 -->
                <div class="slide">
                    <div class="card"><h2>Sistema 1</h2><p>Ventas</p><a href="#">Ingresar</a></div>
                    <div class="card"><h2>Sistema 2</h2><p>Compras</p><a href="#">Ingresar</a></div>
                    <div class="card"><h2>Sistema 3</h2><p>Logística</p><a href="#">Ingresar</a></div>
                    <div class="card"><h2>Sistema 4</h2><p>RRHH</p><a href="#">Ingresar</a></div>
                    <div class="card"><h2>Sistema 5</h2><p>Finanzas</p><a href="#">Ingresar</a></div>
                    <div class="card"><h2>Sistema 6</h2><p>Inventario</p><a href="#">Ingresar</a></div>
                    <div class="card"><h2>Sistema 7</h2><p>Producción</p><a href="#">Ingresar</a></div>
                    <div class="card"><h2>Sistema 8</h2><p>Proyectos</p><a href="#">Ingresar</a></div>
                </div>

                <!-- 🔹 Segundo grupo de 2 -->
                <div class="slide">
                    <div class="card"><h2>Sistema 9</h2><p>Seguridad</p><a href="#">Ingresar</a></div>
                    <div class="card"><h2>Sistema 10</h2><p>CRM</p><a href="#">Ingresar</a></div>
                </div>
            </div>

            <div class="controls">
                <button class="btn" onclick="moveSlide(-1)">❮</button>
                <button class="btn" onclick="moveSlide(1)">❯</button>
            </div>
        </div>
    </div>

    <script>
        let index = 0;
        const slider = document.getElementById("slider");
        const totalSlides = document.querySelectorAll(".slide").length;

        function moveSlide(direction) {
            index += direction;
            if (index < 0) index = totalSlides - 1;
            if (index >= totalSlides) index = 0;
            slider.style.transform = `translateX(-${index * 100}%)`;
        }

        // --- Drag con mouse/touch ---
        let startX = 0;
        let isDragging = false;

        slider.addEventListener("mousedown", (e) => {
            startX = e.pageX;
            isDragging = true;
            slider.style.transition = "none";
        });

        slider.addEventListener("mouseup", (e) => {
            isDragging = false;
            slider.style.transition = "transform 0.6s ease";
            handleSwipe(e.pageX);
        });

        slider.addEventListener("mouseleave", () => {
            if (isDragging) {
                isDragging = false;
                slider.style.transition = "transform 0.6s ease";
            }
        });

        slider.addEventListener("mousemove", (e) => {
            if (!isDragging) return;
            const diff = e.pageX - startX;
            slider.style.transform = `translateX(${-index * 100 + diff / 5}%)`;
        });

        // Touch soporte
        slider.addEventListener("touchstart", (e) => {
            startX = e.touches[0].pageX;
            isDragging = true;
            slider.style.transition = "none";
        });

        slider.addEventListener("touchend", (e) => {
            isDragging = false;
            slider.style.transition = "transform 0.6s ease";
            handleSwipe(e.changedTouches[0].pageX);
        });

        slider.addEventListener("touchmove", (e) => {
            if (!isDragging) return;
            const diff = e.touches[0].pageX - startX;
            slider.style.transform = `translateX(${-index * 100 + diff / 5}%)`;
        });

        function handleSwipe(endX) {
            const diff = endX - startX;
            if (diff > 50) {
                moveSlide(-1);
            } else if (diff < -50) {
                moveSlide(1);
            } else {
                slider.style.transform = `translateX(-${index * 100}%)`;
            }
        }
    </script>
</body>
</html>
