    function loadGridFile() {

        $(() => {
            const DxSource = new DevExpress.data.CustomStore({
                key: 'Cod',

                load() {
                    return sendRequest(`/Reporte/ListarReporteImportacion`).then(data => {
                        return data;
                    });
                },
            });




            const dataGrid =
                $('#gridContainerFile').dxDataGrid({
                    allowExpandAll: true,
                    expandAll: true,
                    keyExpr: 'Cod',

                    noDataText: "No hay información para mostrar",


                    allowSorting: false,
                    allowFiltering: true,
                    allowColumnResizing: true,
                    showRowTotals: true,
                    showColumnTotals: true,
                    showRowGrandTotals: true,
                    showTotals: true,
                    columnMinWidth: 50,
                    columnAutoWidth: true,


                    
                    height: 700,
                    fieldChooser: {
                        enabled: false,
                    },

                    dataSource: {
                        store: DxSource,
                    },

                    scrolling: {
                        columnRenderingMode: 'virtual',
                    },
                    


                    hoverStateEnabled: false,
                    filterRow: { visible: true },
                    showColumnLines: true,
                    showRowLines: true,
                    rowAlternationEnabled: true,
                    showBorders: true,
                    selection: {
                        mode: 'single',
                    },
                    paging: {
                        pageSize: 17,  // Set the number of rows per page as per your requirement
                    },



                }).dxDataGrid('instance');


        })

    }

    function Actualizar() {
        var dataGrid = $('#gridContainerFile').dxDataGrid('instance');
        dataGrid.refresh();
    }
    function Exportar() {
        var workbook = new ExcelJS.Workbook();
        var worksheet = workbook.addWorksheet("Reporte");

        DevExpress.excelExporter.exportDataGrid({
            component: $("#gridContainerFile").dxDataGrid("instance"),
            worksheet: worksheet
        }).then(function () {
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), "ReporteImportacion.xlsx");
            });
        });
    }
